{
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "allowJs": false,
    "skipLibCheck": true,
    "esModuleInterop": false,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "moduleResolution": "Node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": false,
    "noEmitOnError": false,  // Added to allow emit even with errors
    "jsx": "react-jsx",
    "noImplicitAny": false,  // Adjust as needed
    "strictNullChecks": false  // Adjust as needed
  },
  "include": ["src"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
